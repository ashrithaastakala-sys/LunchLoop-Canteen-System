# ============================================================================
# LunchLoop: Environment Configuration Template
# Copy this file to .env and supply your project credentials
# ============================================================================

# Application Server
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Campus Operational Settings
CAMPUS_TIMEZONE=Asia/Kolkata
CANCELLATION_CUTOFF_MINUTES=10

# Supabase Project Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Session/Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
