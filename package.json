{
  "name": "lunchloop",
  "version": "1.0.0",
  "description": "LunchLoop: Canteen Pre-Order and Peak-Hour Queue Management System",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "migrate": "node server/src/scripts/migrate.js",
    "test": "node --test server/tests/unit/businessRules.test.js server/tests/api/apiEndpoints.test.js",
    "test:unit": "node --test server/tests/unit/businessRules.test.js",
    "test:api": "node --test server/tests/api/apiEndpoints.test.js",
    "check": "node --check server/src/server.js"
  },
  "keywords": [
    "canteen",
    "preorder",
    "queue-management",
    "express",
    "supabase",
    "lunchloop"
  ],
  "author": "LunchLoop Engineering",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
